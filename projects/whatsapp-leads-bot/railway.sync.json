{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": ["/projects/whatsapp-leads-bot/**"]
  },
  "deploy": {
    "startCommand": "python -m app.sync_listings",
    "cronSchedule": "*/30 * * * *",
    "restartPolicyType": "NEVER"
  }
}
