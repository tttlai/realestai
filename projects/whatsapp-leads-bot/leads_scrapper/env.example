# Realest AI lead finder settings
# Copy this file to .env and fill it in. Keep .env out of git: it holds your token.
# Any command-line flag overrides the value here for that run.

# Apify Console > Settings > API & Integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxx

# Where to search
CITY=Pune
AREAS=Baner,Wakad,Hinjewadi

# How much to pull (higher = more leads, more cost)
META_LIMIT=100
MAPS_LIMIT=60

# Max USD each Apify run may charge (0 = no cap)
MAX_COST_USD=2

# Yes/no switches (true / false)
EMAILS=false
REUSE_META=false
REUSE_MAPS=false
SKIP_META=false
SKIP_MAPS=false
