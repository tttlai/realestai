# Copy to .env for local runs. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-haiku-5-5
AGENT_EFFORT=medium          # low / medium / high
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=           # pin a current Graph API version, e.g. v24.0
TOKEN_ENCRYPTION_KEY=         # Fernet key
TRANSCRIPTION_PROVIDER=whisper   # or sarvam
OPENAI_API_KEY=               # if whisper
SARVAM_API_KEY=               # if sarvam
GOOGLE_SERVICE_ACCOUNT_JSON=
INBOUND_EMAIL_SECRET=         # basic-auth password Postmark sends; unset = email endpoint off
INBOUND_EMAIL_ADDRESS=        # e.g. abc123@inbound.postmarkapp.com, to print forwarding addresses
LOG_LEVEL=INFO
